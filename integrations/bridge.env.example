# IY HOMELAB metrics bridge configuration.
# Copy to integrations/bridge.env and fill in real values. bridge.env is gitignored.
#
#   cp integrations/bridge.env.example integrations/bridge.env
#   # edit integrations/bridge.env
#   source integrations/bridge.env
#   python3 integrations/proxmox_bridge.py

# --- Home Assistant ---
export HA_URL="https://ha.example.com"
# Long-lived access token (HA -> Profile -> Security -> Long-lived tokens).
# Do NOT hardcode a real token in this committed example. Either paste it into
# your gitignored bridge.env, or export it from your shell profile and leave
# this as a passthrough.
export HA_TOKEN="${HA_TOKEN:-PUT_HA_LONG_LIVED_TOKEN_HERE}"

# --- Proxmox VE (read-only PVEAuditor token) ---
export PVE_HOST="<PVE_NODE_IP>"
export PVE_PORT="8006"
export PVE_TOKEN_ID="monitoring@pve!display"
export PVE_TOKEN_SECRET="PUT_PROXMOX_TOKEN_SECRET_HERE"
# SHA-256 fingerprint of the Proxmox node cert, used for TLS pinning
# (Proxmox ships a self-signed cert; we pin rather than disable verification).
export PVE_FINGERPRINT="AA:BB:CC:DD:...:FF"
export PVE_NODES="kubelab-1,kubelab-2,kubelab-3"

# --- Kubernetes ---
export ENABLE_K8S="1"
export KUBECONFIG="$HOME/.kube/config"
export KUBECTL="kubectl"

# --- UPS (optional; leave empty = display shows unknown) ---
export UPS_SOURCE=""

# --- Bridge behaviour ---
export POLL_INTERVAL="15"
export ONESHOT="0"
